<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IPTV Live Player</title>
    <link href="https://cdn.jsdelivr.net/npm/video.js@8.10.0/dist/video-js.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #00d4ff;
            --primary-dark: #0099cc;
            --bg-dark: #0f0f0f;
            --bg-card: #1a1a1a;
            --bg-overlay: rgba(15, 15, 15, 0.95);
            --text-primary: #ffffff;
            --text-secondary: #b0b0b0;
            --border: #333333;
        }

        html, body {
            width: 100%;
            height: 100%;
            background: var(--bg-dark);
            color: var(--text-primary);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            overflow: hidden;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ========== MAIN CONTAINER ========== */
        #app-container {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* ========== TOP BAR ========== */
        #top-bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            background: linear-gradient(180deg, rgba(15, 15, 15, 0.9), rgba(15, 15, 15, 0));
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 30px;
            z-index: 100;
            font-size: 16px;
        }

        #app-title {
            font-weight: 600;
            letter-spacing: 1px;
            color: var(--primary);
        }

        #datetime {
            color: var(--text-secondary);
            font-size: 14px;
        }

        /* ========== CATEGORIES VIEW ========== */
        #categories {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 40px;
            padding: 60px 30px 30px;
        }

        .category-title {
            font-size: 32px;
            font-weight: 300;
            letter-spacing: 2px;
            color: var(--text-primary);
        }

        .categories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 20px;
            width: 100%;
            max-width: 900px;
            padding: 0 20px;
        }

        .cat-btn {
            aspect-ratio: 1;
            background: var(--bg-card);
            border: 2px solid transparent;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .cat-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--primary);
            opacity: 0;
            transition: opacity 0.3s;
            border-radius: inherit;
            z-index: -1;
        }

        .cat-btn:hover,
        .cat-btn:focus {
            border-color: var(--primary);
            transform: scale(1.08);
            outline: none;
        }

        .cat-btn:active {
            transform: scale(0.95);
        }

        /* ========== CHANNELS VIEW ========== */
        #channels-view {
            width: 100%;
            height: 100%;
            display: none;
            flex-direction: column;
            position: relative;
        }

        #channels-header {
            height: 60px;
            background: linear-gradient(180deg, rgba(15, 15, 15, 0.9), rgba(15, 15, 15, 0));
            display: flex;
            align-items: center;
            padding: 0 30px;
            z-index: 100;
            gap: 20px;
        }

        .back-btn {
            width: 40px;
            height: 40px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: all 0.2s;
        }

        .back-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        #channels-title {
            font-size: 20px;
            font-weight: 500;
            color: var(--text-secondary);
        }

        #channels-grid {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 16px;
            padding: 20px 30px;
            overflow-y: auto;
            align-content: start;
        }

        .ch-btn {
            aspect-ratio: 1;
            background: var(--bg-card);
            border: 2px solid var(--border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 500;
            text-align: center;
            padding: 10px;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .ch-btn:hover,
        .ch-btn:focus {
            border-color: var(--primary);
            transform: scale(1.05);
            outline: none;
        }

        .ch-btn:active {
            background: var(--primary);
            color: var(--bg-dark);
            border-color: var(--primary);
        }

        /* ========== PLAYER VIEW ========== */
        #player-view {
            width: 100%;
            height: 100%;
            display: none;
            position: relative;
            background: #000000;
        }

        .video-js {
            width: 100%;
            height: 100%;
        }

        /* ========== OVERLAY MENU ========== */
        #overlay-menu {
            position: fixed;
            inset: 0;
            background: rgba(15, 15, 15, 0.92);
            display: none;
            flex-direction: column;
            z-index: 1000;
            animation: fadeIn 0.2s ease;
            backdrop-filter: blur(4px);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        #overlay-menu.active {
            display: flex;
        }

        #overlay-header {
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            border-bottom: 1px solid var(--border);
        }

        #overlay-channels {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 16px;
            padding: 20px 30px;
            overflow-y: auto;
            align-content: start;
        }

        .overlay-ch-btn {
            aspect-ratio: 1;
            background: var(--bg-card);
            border: 2px solid var(--border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 500;
            text-align: center;
            padding: 10px;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .overlay-ch-btn:hover,
        .overlay-ch-btn:focus {
            border-color: var(--primary);
            transform: scale(1.05);
            outline: none;
        }

        .overlay-ch-btn.active {
            background: var(--primary);
            color: var(--bg-dark);
            border-color: var(--primary);
        }

        .overlay-ch-btn:active {
            transform: scale(0.95);
        }

        #close-menu-btn {
            padding: 10px 20px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
        }

        #close-menu-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        /* ========== HIDDEN ========== */
        .hidden {
            display: none !important;
        }

        /* ========== SCROLLBAR ========== */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--primary);
        }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 768px) {
            .category-title {
                font-size: 24px;
            }

            .categories-grid {
                grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
                gap: 16px;
            }

            .cat-btn {
                font-size: 16px;
            }

            #top-bar {
                height: 50px;
                padding: 0 20px;
            }

            #channels-header {
                padding: 0 20px;
            }

            #channels-grid,
            #overlay-channels {
                grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
                gap: 12px;
                padding: 16px 20px;
            }

            #overlay-menu {
                padding-top: 0;
            }

            #overlay-header {
                padding: 0 20px;
                height: 60px;
            }
        }

        @media (max-width: 480px) {
            .category-title {
                font-size: 18px;
                letter-spacing: 0.5px;
            }

            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
                max-width: 100%;
            }

            .cat-btn {
                font-size: 14px;
            }

            #top-bar {
                height: 45px;
                padding: 0 15px;
                font-size: 14px;
            }

            #app-title {
                font-size: 14px;
            }

            #datetime {
                font-size: 12px;
            }

            #channels-grid,
            #overlay-channels {
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
                padding: 12px 15px;
            }

            .ch-btn,
            .overlay-ch-btn {
                font-size: 12px;
            }
        }
    </style>
</head>
<body>
    <div id="app-container">
        <!-- TOP BAR -->
        <div id="top-bar">
            <div id="app-title">IPTV LIVE</div>
            <div id="datetime"></div>
        </div>

        <!-- CATEGORIES VIEW -->
        <div id="categories">
            <div class="category-title">LIVE TV</div>
            <div class="categories-grid">
                <button class="cat-btn" data-category="live">🔴 LIVE</button>
                <button class="cat-btn" data-category="movies">🎬 MOVIES</button>
                <button class="cat-btn" data-category="sports">⚽ SPORTS</button>
                <button class="cat-btn" data-category="kids">🎨 KIDS</button>
            </div>
        </div>

        <!-- CHANNELS VIEW -->
        <div id="channels-view">
            <div id="channels-header">
                <button class="back-btn" id="back-btn">← BACK</button>
                <div id="channels-title"></div>
            </div>
            <div id="channels-grid"></div>
        </div>

        <!-- PLAYER VIEW -->
        <div id="player-view">
            <video
                id="videoPlayer"
                class="video-js vjs-default-skin"
                controls
                preload="auto"
                width="100%"
                height="100%"
                playsinline
            >
                <p class="vjs-no-js">
                    To view this video please enable JavaScript, and consider upgrading to a
                    web browser that
                    <a href="https://videojs.com/html5-video-support/" target="_blank">
                        supports HTML5 video
                    </a>
                </p>
            </video>
        </div>
    </div>

    <!-- OVERLAY MENU (Press OK/Enter) -->
    <div id="overlay-menu">
        <div id="overlay-header">
            <div style="font-size: 18px; font-weight: 500;">CHANNELS</div>
            <button id="close-menu-btn">Close (ESC)</button>
        </div>
        <div id="overlay-channels"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/video.js@8.10.0/dist/video.min.js"></script>
    <script>
        // ========== CHANNEL LIST ==========
        const channels = {
            live: [
                { name: "RTK 1", url: "http://gjirafa-video-live.gjirafa.net/gjvideo-livestream/98r-d35-487-v6m/tracks-v4a1/mono.ts.m3u8" },
                { name: "RTK 3", url: "http://gjirafa-video-live.gjirafa.net/gjvideo-livestream/rtk3/tracks-v4a1/mono.ts.m3u8" },
                { name: "T7", url: "http://gjirafa-video-live.gjirafa.net/gjvideo-livestream-specific/1z8-byc-4ee-lc9/tracks-v2a1/mono.m3u8" },
                { name: "RTV21 HD", url: "http://gjirafa-video-live.gjirafa.net/gjvideo-live/2cz-npl-jfn-9he/tracks-v2a1/mono.m3u8" },
                { name: "KTV HD", url: "http://gjirafa-video-live.gjirafa.net/gjvideo-livestream/lj9-pxm-o53-rp0/tracks-v4a1/mono.m3u8" },
                { name: "Test 1", url: "#" },
                { name: "Test 2", url: "#" },
                { name: "Test 3", url: "#" },
            ],
            movies: [
                { name: "Action Movie 1", url: "#" },
                { name: "Drama Movie 2", url: "#" },
                { name: "Comedy Movie 3", url: "#" },
            ],
            sports: [
                { name: "Sports HD 1", url: "#" },
                { name: "Sports HD 2", url: "#" },
                { name: "Sports HD 3", url: "#" },
            ],
            kids: [
                { name: "Kids Show 1", url: "#" },
                { name: "Kids Show 2", url: "#" },
                { name: "Kids Show 3", url: "#" },
            ]
        };

        // ========== DOM ELEMENTS ==========
        const categoriesView = document.getElementById("categories");
        const channelsView = document.getElementById("channels-view");
        const playerView = document.getElementById("player-view");
        const channelsGrid = document.getElementById("channels-grid");
        const channelsTitle = document.getElementById("channels-title");
        const backBtn = document.getElementById("back-btn");
        const overlayMenu = document.getElementById("overlay-menu");
        const overlayChannels = document.getElementById("overlay-channels");
        const closeMenuBtn = document.getElementById("close-menu-btn");

        let currentPlayer = null;
        let currentChannels = [];
        let currentCategory = null;
        let currentChannel = null;

        // ========== DATE/TIME ==========
        function updateDateTime() {
            const now = new Date();
            document.getElementById("datetime").textContent = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();

        // ========== CATEGORY CLICK ==========
        document.querySelectorAll(".cat-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                const category = btn.dataset.category;
                openCategory(category);
            });
        });

        // ========== OPEN CATEGORY ==========
        function openCategory(category) {
            currentCategory = category;
            categoriesView.classList.add("hidden");
            channelsView.classList.remove("hidden");
            
            const categoryNames = { live: "🔴 LIVE", movies: "🎬 MOVIES", sports: "⚽ SPORTS", kids: "🎨 KIDS" };
            channelsTitle.textContent = categoryNames[category] || category.toUpperCase();

            currentChannels = channels[category] || [];
            renderChannels();
        }

        // ========== RENDER CHANNELS ==========
        function renderChannels() {
            channelsGrid.innerHTML = "";
            currentChannels.forEach((ch, idx) => {
                const btn = document.createElement("button");
                btn.className = "ch-btn";
                btn.textContent = ch.name;
                btn.addEventListener("click", () => playChannel(ch, idx));
                channelsGrid.appendChild(btn);
            });
        }

        // ========== RENDER OVERLAY CHANNELS ==========
        function renderOverlayChannels() {
            overlayChannels.innerHTML = "";
            currentChannels.forEach((ch, idx) => {
                const btn = document.createElement("button");
                btn.className = "overlay-ch-btn";
                if (currentChannel && currentChannel.name === ch.name) {
                    btn.classList.add("active");
                }
                btn.textContent = ch.name;
                btn.addEventListener("click", () => {
                    closeOverlayMenu();
                    playChannel(ch, idx);
                });
                overlayChannels.appendChild(btn);
            });
        }

        // ========== PLAY CHANNEL ==========
        function playChannel(channel, idx) {
            currentChannel = channel;
            channelsView.classList.add("hidden");
            playerView.classList.remove("hidden");

            if (currentPlayer) {
                currentPlayer.dispose();
            }

            const videoElement = document.getElementById("videoPlayer");
            currentPlayer = videojs("videoPlayer", {
                autoplay: true,
                controls: true,
                muted: false,
                fluid: true
            });

            if (channel.url && channel.url !== "#") {
                currentPlayer.src({ src: channel.url, type: "application/x-mpegURL" });
                currentPlayer.play();
            }
        }

        // ========== BACK BUTTON ==========
        backBtn.addEventListener("click", () => {
            channelsView.classList.add("hidden");
            categoriesView.classList.remove("hidden");
            currentCategory = null;
        });

        // ========== OVERLAY MENU - OPEN ==========
        function openOverlayMenu() {
            renderOverlayChannels();
            overlayMenu.classList.add("active");
        }

        // ========== OVERLAY MENU - CLOSE ==========
        function closeOverlayMenu() {
            overlayMenu.classList.remove("active");
        }

        // ========== KEYBOARD CONTROLS ==========
        document.addEventListener("keydown", (e) => {
            // Press Enter or Space to open overlay menu while playing
            if ((e.key === "Enter" || e.key === " ") && playerView.classList.contains("hidden") === false) {
                e.preventDefault();
                openOverlayMenu();
            }

            // Press Escape to close overlay menu
            if (e.key === "Escape" && overlayMenu.classList.contains("active")) {
                e.preventDefault();
                closeOverlayMenu();
            }
        });

        // ========== CLOSE BUTTON ==========
        closeMenuBtn.addEventListener("click", closeOverlayMenu);

        // ========== OVERLAY MENU - CLOSE ON OUTSIDE CLICK ==========
        overlayMenu.addEventListener("click", (e) => {
            if (e.target === overlayMenu) {
                closeOverlayMenu();
            }
        });
    </script>
</body>
</html>
